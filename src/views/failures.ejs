<%- include('partials/shell') %>

<section class="cards failure-cards">
  <article class="stat-card" data-tone="error">
    <small class="stat-label"><%= t('nav.failures') %></small>
    <h2><%= total.toLocaleString(locale) %></h2>
  </article>
  <article class="stat-card" data-tone="clients">
    <small class="stat-label"><%= t('nav.clients') %></small>
    <h2><%= summary.clients.length %></h2>
  </article>
  <article class="stat-card" data-tone="endpoints">
    <small class="stat-label"><%= t('nav.endpoints') %></small>
    <h2><%= summary.endpoints.length %></h2>
  </article>
  <article class="stat-card" data-tone="error">
    <small class="stat-label"><%= t('stats.httpErrors') %></small>
    <h2><%= httpErrors.toLocaleString(locale) %></h2>
  </article>
</section>

<%- include('partials/filters') %>

<section class="panel" id="results">
  <div class="table-heading"><h3><%= t('nav.failures') %> <span><%= total.toLocaleString(locale) %></span></h3></div>
  <div class="scroll" tabindex="0" role="region" aria-label="<%= t('table.recentFailures') %>">
    <table>
      <thead>
        <tr>
          <%- include('partials/sort-header', { column: 'time', label: t('common.date') }) %>
          <%- include('partials/sort-header', { column: 'ip', label: t('common.client') }) %>
          <%- include('partials/sort-header', { column: 'statusCode', label: t('common.http') }) %>
          <%- include('partials/sort-header', { column: 'resource', label: t('common.resource') }) %>
          <%- include('partials/sort-header', { column: 'reason', label: t('common.reason') }) %>
        </tr>
      </thead>
      <tbody>
        <% for (const event of events) { %>
          <% const client = clientName(event.ip); %>
          <tr>
            <td class="nowrap"><%= date(event.time) %></td>
            <td class="nowrap">
              <a class="entity-link" href="<%= filterUrl({ ip: event.ip }) %>" data-client-ip="<%= event.ip %>" title="<%= t('table.filterClient') %>">
                <span class="client-address"><%= event.ip %></span>
                <span class="client-host"><%= client %></span>
              </a>
            </td>
            <td>
              <% if (event.statusCode) { %>
                <span class="badge failure-code"><%= event.statusCode %></span>
              <% } else { %>
                <span class="meta">—</span>
              <% } %>
            </td>
            <td class="resource"><%= event.resource %></td>
            <td class="failure-reason">
              <% if (httpStatusLabel(event.statusCode)) { %>
                <strong class="http-reason"><%= event.statusCode %> — <%= httpStatusLabel(event.statusCode) %></strong>
                <span class="failure-detail"><%= eventReason(event) %></span>
              <% } else { %>
                <%= eventReason(event) %>
              <% } %>
            </td>
          </tr>
        <% } %>
        <% if (!events.length) { %>
          <tr>
            <td colspan="5">
              <%= t('table.noFailures') %>
              <% if (activeFilters.length) { %>
                <a href="<%= basePath %>"><%= t('common.clearFilters') %></a>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('partials/pagination') %>
</section>

<%- include('partials/end') %>
