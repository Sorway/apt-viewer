<%- include('partials/shell') %>
<%- include('partials/filters') %>

<section class="panel group-panel" id="results" aria-labelledby="group-title">
  <div class="table-heading">
    <h3 id="group-title"><%= pageTitle %> <span><%= resultTotal.toLocaleString(locale) %></span></h3>
  </div>
  <div class="scroll page-table" tabindex="0" role="region" aria-label="<%= pageTitle %>">
    <table>
      <thead>
        <tr>
          <%- include('partials/sort-header', { column: 'name', label: screen === 'clients' ? t('table.clientName') : t('common.endpoint') }) %>
          <%- include('partials/sort-header', { column: 'in', label: t('common.incoming') }) %>
          <%- include('partials/sort-header', { column: 'out', label: t('common.outgoing') }) %>
          <%- include('partials/sort-header', { column: 'count', label: t('common.events') }) %>
          <%- include('partials/sort-header', { column: 'last', label: t('table.lastActivity') }) %>
        </tr>
      </thead>
      <tbody>
        <% for (const row of groupRows) { %>
          <%
            const client = screen === 'clients' ? clientName(row.name) : '';
            const filter = screen === 'clients' ? { ip: row.name } : { endpoint: row.name };
          %>
          <tr>
            <td>
              <a class="entity-link" href="<%= filterUrl(filter, '/activity') %>" <% if (screen === 'clients') { %>data-client-ip="<%= row.name %>"<% } %> title="<%= t('table.viewActivity') %>">
                <span class="client-address"><%= row.name %></span>
                <% if (screen === 'clients') { %><span class="client-host"><%= client %></span><% } %>
              </a>
            </td>
            <td class="nowrap"><%= bytes(row.in) %></td>
            <td class="nowrap"><%= bytes(row.out) %></td>
            <td><%= row.count.toLocaleString(locale) %></td>
            <td class="nowrap"><%= date(row.last) %></td>
          </tr>
        <% } %>
        <% if (!groupRows.length) { %>
          <tr>
            <td colspan="5">
              <%= t('common.empty') %>
              <% if (activeFilters.length) { %>
                <a href="<%= basePath %>"><%= t('common.clearFilters') %></a>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('partials/pagination') %>
</section>

<%- include('partials/end') %>
