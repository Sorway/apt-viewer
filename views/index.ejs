<%- include('partials/shell') %>

<section class="cards" aria-label="Statistiques">
  <article class="stat-card" data-tone="out">
    <div class="stat-header"><small class="stat-label">Envoyé aux clients</small></div>
    <h2><%= bytes(summary.outgoing) %></h2>
  </article>
  <article class="stat-card" data-tone="in">
    <div class="stat-header"><small class="stat-label">Reçu de l’amont</small></div>
    <h2><%= bytes(summary.incoming) %></h2>
  </article>
  <a class="stat-card stat-link" data-tone="clients" href="<%= filterUrl({}, '/clients') %>" aria-label="<%= summary.clients.length %> clients">
    <div class="stat-header">
      <small class="stat-label">Clients</small>
      <span class="stat-arrow" aria-hidden="true">↗</span>
    </div>
    <h2><%= summary.clients.length %></h2>
  </a>
  <a class="stat-card stat-link" data-tone="endpoints" href="<%= filterUrl({}, '/endpoints') %>" aria-label="<%= summary.endpoints.length %> dépôts">
    <div class="stat-header">
      <small class="stat-label">Dépôts</small>
      <span class="stat-arrow" aria-hidden="true">↗</span>
    </div>
    <h2><%= summary.endpoints.length %></h2>
  </a>
</section>

<%- include('partials/filters') %>

<div class="overview-charts">
  <%- include('partials/activity-chart', {
    chart: clientActivity,
    chartId: 'client-activity',
    title: 'Activité par client',
    column: 'Client',
    clientChart: true,
  }) %>
  <%- include('partials/activity-chart', {
    chart: destinationActivity,
    chartId: 'destination-activity',
    title: 'Activité par destination',
    column: 'Destination',
    clientChart: false,
  }) %>
</div>

<div class="overview-action">
  <a class="button-secondary" href="<%= filterUrl({}, '/activity') %>">Voir toute l’activité →</a>
</div>

<%- include('partials/end') %>
