<section class="filter-panel" aria-labelledby="filter-title">
  <div class="filter-heading">
    <h2 id="filter-title">Filtres</h2>
    <span><%= total.toLocaleString('fr-FR') %> <%= failures ? 'échecs' : 'événements' %><%= activeFilters.length ? ' dans la sélection' : '' %></span>
  </div>
  <form method="get" action="<%= basePath %>" class="filters">
    <label class="search-field">
      <%= failures ? 'Ressource ou motif' : 'Ressource' %>
      <input
        type="search"
        name="q"
        value="<%= q.q %>"
        placeholder="<%= failures ? 'Paquet, dépôt, motif…' : 'Rechercher un paquet…' %>"
        maxlength="200"
      >
    </label>
    <div class="select-field">
      <label for="client-ip">Client IP</label>
      <select id="client-ip" name="ip" data-search-select data-search-placeholder="Rechercher une IP ou un nom…">
        <option value="">Tous les clients</option>
        <% if (q.ip && !options.clients.some(client => client.name === q.ip)) { %>
          <option value="<%= q.ip %>" selected><%= q.ip %> · hors fenêtre</option>
        <% } %>
        <% for (const client of options.clients) { %>
          <% const name = clientName(client.name); %>
          <option value="<%= client.name %>" data-client-ip="<%= client.name %>" <%= q.ip === client.name ? 'selected' : '' %>><%= client.name %><%= name ? ` (${name})` : '' %></option>
        <% } %>
      </select>
    </div>
    <div class="select-field">
      <label for="endpoint-filter">Dépôt</label>
      <select id="endpoint-filter" name="endpoint" data-search-select data-search-placeholder="Rechercher un dépôt…">
        <option value="">Tous les dépôts</option>
        <% if (q.endpoint && !options.endpoints.some(endpoint => endpoint.name === q.endpoint)) { %>
          <option value="<%= q.endpoint %>" selected><%= q.endpoint %> · hors fenêtre</option>
        <% } %>
        <% for (const endpoint of options.endpoints) { %>
          <option <%= q.endpoint === endpoint.name ? 'selected' : '' %>><%= endpoint.name %></option>
        <% } %>
      </select>
    </div>
    <% if (failures) { %>
      <label>
        Code HTTP
        <select name="code">
          <option value="">Tous les codes</option>
          <% if (q.code && q.code !== 'unknown' && !codes.includes(Number(q.code))) { %>
            <option value="<%= q.code %>" selected><%= q.code %> · hors fenêtre</option>
          <% } %>
          <% for (const code of codes) { %>
            <option value="<%= code %>" <%= q.code === String(code) ? 'selected' : '' %>><%= code %></option>
          <% } %>
          <option value="unknown" <%= q.code === 'unknown' ? 'selected' : '' %>>Sans code HTTP</option>
        </select>
      </label>
    <% } else { %>
      <label>
        Flux
        <select name="direction">
          <option value="">Tous les flux</option>
          <option value="I" <%= q.direction === 'I' ? 'selected' : '' %>>Entrant · I</option>
          <option value="O" <%= q.direction === 'O' ? 'selected' : '' %>>Sortant · O</option>
        </select>
      </label>
    <% } %>
    <details class="date-filters" <%= q.from || q.to ? 'open' : '' %>>
      <summary>Période<%= q.from || q.to ? ' · active' : '' %></summary>
      <div class="date-fields">
        <label>
          Depuis (UTC)
          <input type="datetime-local" name="from" value="<%= q.from %>">
        </label>
        <label>
          Jusqu’au (UTC)
          <input type="datetime-local" name="to" value="<%= q.to %>">
        </label>
      </div>
    </details>
    <div class="filter-actions">
      <button type="submit">Appliquer</button>
      <% if (activeFilters.length) { %>
        <a class="button-secondary" href="<%= basePath %>" aria-label="Réinitialiser tous les filtres">Réinitialiser</a>
      <% } %>
    </div>
    <p class="filter-feedback" role="status" hidden>Filtres modifiés · cliquez sur Appliquer.</p>
  </form>
  <% if (activeFilters.length) { %>
    <div class="active-filters" aria-label="Filtres actifs">
      <% for (const filter of activeFilters) { %>
        <a class="filter-chip" href="<%= filter.url %>" aria-label="Retirer le filtre <%= filter.label %> : <%= filter.value %>">
          <span><%= filter.label %> : <%= filter.value %></span>
          <span aria-hidden="true">×</span>
        </a>
      <% } %>
    </div>
  <% } %>
</section>
