<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= pageTitle %> · apt-viewer · <%= name %></title>
  <link rel="icon" href="/assets/brand/logo.svg" type="image/svg+xml">
  <script src="<%= assetUrl('theme.js') %>"></script>
  <link rel="stylesheet" href="<%= assetUrl('style.css') %>">
  <script src="<%= assetUrl('app.js') %>" defer></script>
  <script src="<%= assetUrl('pagination.js') %>" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Aller au contenu</a>
<div class="app-bar">
  <div class="brand">
    <img src="/assets/brand/logo.svg" alt="" width="28" height="28">
    <span class="logo">apt-viewer</span>
  </div>
  <nav class="primary-nav" aria-label="Navigation principale">
    <% for(const item of navigation){ %>
    <a href="<%= filterUrl({},item.path) %>" class="<%= screen===item.id?'active':'' %> <%= item.id==='failures'?'failures-link':'' %>" data-nav-page="<%= item.id %>" <%- screen===item.id?'aria-current="page"':'' %>><span class="nav-label"><%= item.title %></span><% if(item.id==='failures'){ %><span class="nav-count <%= failureCount?'nav-count-error':'' %>" title="Échecs dans tout le fichier chargé"><%= failureCount.toLocaleString('fr-FR') %></span><% } %></a>
    <% } %>
  </nav>
  <div class="bar-server"><%- include('nav-icon',{id:'server'}) %><span title="<%= name %>"><%= name %></span></div>
</div>
<main id="main" tabindex="-1">
  <header class="page-header">
    <h1><%= pageTitle %></h1>
    <div class="refresh">
      <div class="theme-switch" role="group" aria-label="Apparence"><button type="button" data-theme-choice="light" aria-pressed="false">Clair</button><button type="button" data-theme-choice="dark" aria-pressed="false">Sombre</button></div>
      <button id="refresh" class="button-secondary" type="button">Actualiser</button>
      <label class="auto-refresh"><input type="checkbox" id="auto" role="switch" aria-label="Actualisation automatique toutes les 15 secondes"><span>Auto · 15 s</span></label>
      <span id="refresh-status" class="refresh-status" role="status"></span>
    </div>
  </header>
  <% if(demo){ %><div class="notice">Démonstration · données synthétiques</div><% } %>
  <% if(status.error){ %><div class="alert" role="alert">Lecture indisponible : <%= status.error %>. Vérifier le fichier et les droits. Les données affichées peuvent être anciennes.</div><% } %>
  <div class="read-status">
    <span class="read-state <%= status.error?'read-state-error':'' %>"><%= status.error?'Lecture en erreur':'Journal lisible' %></span>
    <span>Dernière lecture : <%= status.readAt ? date(Date.parse(status.readAt)) : 'en attente' %> · Paris</span>
    <% if(status.invalid){ %><span><%= status.invalid %> lignes ignorées</span><% } %>
    <% if(status.truncated){ %><span class="window-warning">Fenêtre partielle : limite de lecture atteinte</span><% } %>
  </div>
