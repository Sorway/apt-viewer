<%- include('partials/shell') %>
<%- include('partials/filters') %>
<section class="panel" id="results"><h3>Activité récente <span><%= total %></span></h3><div class="scroll" tabindex="0" role="region" aria-label="<%= failures?'Échecs récents':'Tableau de données' %>"><table><thead><tr><th scope="col">Date · Paris</th><th scope="col">Client</th><th scope="col">Flux</th><th scope="col">Volume</th><th scope="col">Ressource</th></tr></thead><tbody><% for(const e of events){ %><tr><td class="nowrap"><%= date(e.time) %></td><td class="nowrap"><a href="<%= filterUrl({ip:e.ip}) %>" data-client-ip="<%= e.ip %>" title="Filtrer ce client"><%= e.ip %><%= clientName(e.ip) ? " ("+clientName(e.ip)+")" : "" %></a></td><td><span class="badge <%= e.direction %>" title="<%= e.direction==='I'?'Reçu de l’amont':'Envoyé au client' %>"><%= e.direction==='I'?'I · Entrant':'O · Sortant' %></span></td><td class="nowrap"><%= bytes(e.bytes) %></td><td class="resource"><%= e.resource %></td></tr><% } %><% if(!events.length){ %><tr><td colspan="5">Aucun événement. Vérifiez les filtres ou l’état du journal. <a href="<%= basePath %>">Effacer les filtres</a></td></tr><% } %></tbody></table></div><%- include('partials/pagination') %></section>
<%- include('partials/end') %>
