<%- include('partials/shell') %>
<%- include('partials/filters') %>

<section class="panel" id="results">
  <h3>Activité récente <span><%= total %></span></h3>
  <div class="scroll" tabindex="0" role="region" aria-label="Tableau de données">
    <table>
      <thead>
        <tr>
          <th scope="col">Date · Paris</th>
          <th scope="col">Client</th>
          <th scope="col">Flux</th>
          <th scope="col">Volume</th>
          <th scope="col">Ressource</th>
        </tr>
      </thead>
      <tbody>
        <% for (const event of events) { %>
          <% const client = clientName(event.ip); %>
          <tr>
            <td class="nowrap"><%= date(event.time) %></td>
            <td class="nowrap">
              <a href="<%= filterUrl({ ip: event.ip }) %>" data-client-ip="<%= event.ip %>" title="Filtrer ce client"><%= event.ip %><%= client ? ` (${client})` : '' %></a>
            </td>
            <td>
              <span class="badge <%= event.direction %>" title="<%= event.direction === 'I' ? 'Reçu de l’amont' : 'Envoyé au client' %>">
                <%= event.direction === 'I' ? 'I · Entrant' : 'O · Sortant' %>
              </span>
            </td>
            <td class="nowrap"><%= bytes(event.bytes) %></td>
            <td class="resource"><%= event.resource %></td>
          </tr>
        <% } %>
        <% if (!events.length) { %>
          <tr>
            <td colspan="5">
              Aucun événement. Vérifiez les filtres ou l’état du journal.
              <a href="<%= basePath %>">Effacer les filtres</a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('partials/pagination') %>
</section>

<%- include('partials/end') %>
