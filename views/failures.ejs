<%- include('partials/shell') %>
<section class="cards failure-cards">
  <article data-tone="error"><small>Échecs</small><h2><%= total.toLocaleString('fr-FR') %></h2></article>
  <article data-tone="clients"><small>Clients</small><h2><%= summary.clients.length %></h2></article>
  <article data-tone="endpoints"><small>Dépôts</small><h2><%= summary.endpoints.length %></h2></article>
  <article data-tone="error"><small>Erreurs HTTP</small><h2><%= httpErrors.toLocaleString('fr-FR') %></h2></article>
</section>
<%- include('partials/filters') %>

<section class="panel" id="results"><h3>Échecs récents <span><%= total %></span></h3>
  <div class="scroll" tabindex="0" role="region" aria-label="<%= failures?'Échecs récents':'Tableau de données' %>"><table><thead><tr><th scope="col">Date · Paris</th><th scope="col">Client</th><th scope="col">HTTP</th><th scope="col">Ressource</th><th scope="col">Motif</th></tr></thead><tbody>
  <% for(const e of events){ %><tr>
    <td class="nowrap"><%= date(e.time) %></td>
    <td class="nowrap"><a href="<%= filterUrl({ip:e.ip}) %>" data-client-ip="<%= e.ip %>" title="Filtrer ce client"><%= e.ip %><%= clientName(e.ip) ? ' ('+clientName(e.ip)+')' : '' %></a></td>
    <td><% if(e.statusCode){ %><span class="badge failure-code"><%= e.statusCode %></span><% } else { %><span class="meta">—</span><% } %></td>
    <td class="resource"><%= e.resource %></td><td class="failure-reason"><% if(httpStatusLabel(e.statusCode)){ %><strong class="http-reason"><%= e.statusCode %> — <%= httpStatusLabel(e.statusCode) %></strong><span class="failure-detail"><%= e.reason %></span><% } else { %><%= e.reason %><% } %></td>
  </tr><% } %>
  <% if(!events.length){ %><tr><td colspan="5">Aucun échec enregistré dans cette sélection. <% if(activeFilters.length){ %><a href="<%= basePath %>">Effacer les filtres</a><% } %></td></tr><% } %>
  </tbody></table></div>
  <%- include('partials/pagination') %>
</section>
<%- include('partials/end') %>
