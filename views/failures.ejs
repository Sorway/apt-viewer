<%- include('partials/shell') %>

<section class="cards failure-cards">
  <article class="stat-card" data-tone="error">
    <small class="stat-label">Échecs</small>
    <h2><%= total.toLocaleString('fr-FR') %></h2>
  </article>
  <article class="stat-card" data-tone="clients">
    <small class="stat-label">Clients</small>
    <h2><%= summary.clients.length %></h2>
  </article>
  <article class="stat-card" data-tone="endpoints">
    <small class="stat-label">Dépôts</small>
    <h2><%= summary.endpoints.length %></h2>
  </article>
  <article class="stat-card" data-tone="error">
    <small class="stat-label">Erreurs HTTP</small>
    <h2><%= httpErrors.toLocaleString('fr-FR') %></h2>
  </article>
</section>

<%- include('partials/filters') %>

<section class="panel" id="results">
  <h3>Échecs récents <span><%= total %></span></h3>
  <div class="scroll" tabindex="0" role="region" aria-label="Échecs récents">
    <table>
      <thead>
        <tr>
          <th scope="col">Date · Paris</th>
          <th scope="col">Client</th>
          <th scope="col">HTTP</th>
          <th scope="col">Ressource</th>
          <th scope="col">Motif</th>
        </tr>
      </thead>
      <tbody>
        <% for (const event of events) { %>
          <% const client = clientName(event.ip); %>
          <tr>
            <td class="nowrap"><%= date(event.time) %></td>
            <td class="nowrap">
              <a href="<%= filterUrl({ ip: event.ip }) %>" data-client-ip="<%= event.ip %>" title="Filtrer ce client"><%= event.ip %><%= client ? ` (${client})` : '' %></a>
            </td>
            <td>
              <% if (event.statusCode) { %>
                <span class="badge failure-code"><%= event.statusCode %></span>
              <% } else { %>
                <span class="meta">—</span>
              <% } %>
            </td>
            <td class="resource"><%= event.resource %></td>
            <td class="failure-reason">
              <% if (httpStatusLabel(event.statusCode)) { %>
                <strong class="http-reason"><%= event.statusCode %> — <%= httpStatusLabel(event.statusCode) %></strong>
                <span class="failure-detail"><%= event.reason %></span>
              <% } else { %>
                <%= event.reason %>
              <% } %>
            </td>
          </tr>
        <% } %>
        <% if (!events.length) { %>
          <tr>
            <td colspan="5">
              Aucun échec enregistré dans cette sélection.
              <% if (activeFilters.length) { %>
                <a href="<%= basePath %>">Effacer les filtres</a>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('partials/pagination') %>
</section>

<%- include('partials/end') %>
